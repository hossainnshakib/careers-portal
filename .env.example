# Copy to .env.local and fill in. NEVER commit .env.local.
# Validated by src/lib/env.ts (Zod) — keep this file in sync with that schema.

# development | production
APP_ENV=development
# Independent dev project pin, required for seed:demo and db:reset:dev.
# Use an independently approved NON-PRODUCTION project's reference. The designated
# production target is refused even with APP_ENV=development. Omit in production.
DEV_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (never give production credentials to local dev, previews or cloud tests)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY (secret key)
SUPABASE_SERVICE_ROLE_KEY=
# pooler connection string, used at runtime (prepare: false)
DATABASE_URL=
# used by db:migrate (if the direct connection fails because the network has no IPv6,
# use the session-pooler connection string here instead)
DIRECT_URL=
# Both database clients always verify TLS certificates and hostnames. Optional
# PEM CA certificate from the owner's Supabase Database > Settings > SSL panel.
# Set privately as multiline PEM when the server chain is not publicly trusted.
# Never use sslmode=require/disable, NODE_TLS_REJECT_UNAUTHORIZED=0 or a remote CA URL.
DATABASE_SSL_CA=

# Cloudflare Turnstile (use Cloudflare's published test keys in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs upload-session tokens (server only) — long random string, 32+ chars
UPLOAD_SESSION_SECRET=
# Protects the cron route (server only) — long random string, 32+ chars
CRON_SECRET=
